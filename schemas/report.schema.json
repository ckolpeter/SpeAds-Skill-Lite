{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retail Lite report input v1.0",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "market": {
      "type": "string",
      "enum": [
        "TW"
      ]
    },
    "currency": {
      "type": "string",
      "enum": [
        "TWD"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "synthetic",
            "user_provided"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "kind",
        "note"
      ],
      "additionalProperties": false
    },
    "campaign_mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "start_date": {
      "type": "string",
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}",
      "maxLength": 10
    },
    "end_date": {
      "type": "string",
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}",
      "maxLength": 10
    },
    "attribution_window": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "window_complete": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "rows_disjoint": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "sales_scope": {
      "type": "string",
      "enum": [
        "paid_click",
        "paid_mixed",
        "paid_and_organic",
        "unknown"
      ]
    },
    "revenue_basis": {
      "type": "string",
      "enum": [
        "gross_reported",
        "net_settled",
        "unknown"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
            "maxLength": 64
          },
          "impressions": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "clicks": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "orders": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "spend": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "maxLength": 48,
            "minimum": 0,
            "maximum": 1000000000000.0
          },
          "revenue": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "maxLength": 48,
            "minimum": 0,
            "maximum": 1000000000000.0
          }
        },
        "required": [
          "sku",
          "impressions",
          "clicks",
          "orders",
          "spend",
          "revenue"
        ],
        "additionalProperties": false
      }
    },
    "spend_diagnostics": {
      "type": "object",
      "properties": {
        "low_utilization_threshold": {
          "type": [
            "string",
            "number",
            "null"
          ],
          "maxLength": 48,
          "minimum": 0,
          "maximum": 1000000000000.0
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sku": {
                "type": "string",
                "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
                "maxLength": 64
              },
              "change_date": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}",
                "maxLength": 10
              },
              "change_note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "daily": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string",
                      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}",
                      "maxLength": 10
                    },
                    "organic_visits": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    "ad_impressions": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    "spend": {
                      "type": [
                        "string",
                        "number",
                        "null"
                      ],
                      "maxLength": 48,
                      "minimum": 0,
                      "maximum": 1000000000000.0
                    },
                    "budget": {
                      "type": [
                        "string",
                        "number",
                        "null"
                      ],
                      "maxLength": 48,
                      "minimum": 0,
                      "maximum": 1000000000000.0
                    }
                  },
                  "required": [
                    "date"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 366
              }
            },
            "required": [
              "sku",
              "daily"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        }
      },
      "required": [
        "series"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "platform",
    "market",
    "currency",
    "source",
    "campaign_mode",
    "start_date",
    "end_date",
    "attribution_window",
    "window_complete",
    "rows_disjoint",
    "sales_scope",
    "revenue_basis",
    "rows"
  ],
  "additionalProperties": false
}
